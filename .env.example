# ALASKA Sandbox Environment Configuration Template
# Copy this file to .env and configure with your API keys.
# NEVER commit your real .env file to public version control.

# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Obtain from Groq Console)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Open-Meteo & Overpass Endpoints
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
